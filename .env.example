# --- Base de données Postgres (avec extension pgvector) ---
DATABASE_URL=postgresql://limerx:limerx@localhost:5432/limerx

# --- Gemini (Google AI Studio) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modeles Gemini utilises (ajustables sans changer le code)
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Auth.js (NextAuth) ---
# Generer avec: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Stripe (facturation SaaS, optionnel au demarrage) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
