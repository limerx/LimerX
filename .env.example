# --- Base de données Postgres (avec extension pgvector) ---
DATABASE_URL=postgresql://limerx:limerx@localhost:5432/limerx

# --- Gemini (Google AI Studio) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modeles Gemini utilises (ajustables sans changer le code)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-latest
# Doit rester en phase avec `vector(N)` dans db/schema.sql
EMBEDDING_DIMENSIONS=768

# --- Auth.js (NextAuth) ---
# Generer avec: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Stripe (facturation SaaS, optionnel au demarrage) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Telegram (canal alternatif au chat web) ---
# Token obtenu via @BotFather
TELEGRAM_BOT_TOKEN=
# Chat id recevant les notifications d'erreur (optionnel)
TELEGRAM_ADMIN_CHAT_ID=
# Chaine aleatoire verifiee sur chaque appel webhook (header X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# URL HTTPS publique une fois deployee, ex: https://mon-app.vercel.app/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Domaine de connaissance servi par le bot (doit exister dans la table `domains`)
TELEGRAM_DEFAULT_DOMAIN=nf-c15-100
